# ============================================================
# appdatareview — configuração (copie: `cp .env.example .env`)
# ============================================================
# O setup (scripts/setup.sh) já copia este arquivo automaticamente.
# Valores abaixo = MODO LOCAL (backend em :8787 + Ollama). Não precisa
# editar nada para começar.

# ------ Backend local (server/ — reimplementa as edge functions) ------
VITE_SUPABASE_PROJECT_ID="local"
VITE_SUPABASE_PUBLISHABLE_KEY="local-anon-key"
VITE_SUPABASE_URL="http://localhost:8787"

# ------ IA local (Ollama) ------
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b"    # RTX 3060 12GB: gemma3:4b c/ 32k ctx na GPU (mais leve = geração mais rápida)

# ------ Porta do servidor local ------
PORT=8787

# ------ Git Canvas (página /git) — opcional ------
# Token do GitHub (scope: repo). Fica SÓ no servidor — nunca vai ao browser.
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
# Repositório padrão exibido no onboarding: owner/name
# GITHUB_REPO="emersonalmeida/appdatareview"

# ------ Voz local (Chat com voz) — opcional ------
# Instale com: scripts/setup-voice.sh  (venv do projeto, sem sudo)
# WHISPER_MODEL="small"        # tiny/base/small/medium (GPU 12GB: small vai bem)
# WHISPER_DEVICE="cuda"        # cuda (padrão) | cpu
# PIPER_MODEL="pt_BR-faber-medium"

# ============================================================
# MODO CLOUD (Lovable/Supabase original) — opcional
# Para usar o backend cloud, comente o bloco LOCAL acima e use:
# VITE_SUPABASE_PROJECT_ID="zqkiscywzyruqaevarsl"
# VITE_SUPABASE_PUBLISHABLE_KEY="<sua chave publishable>"
# VITE_SUPABASE_URL="https://zqkiscywzyruqaevarsl.supabase.co"
# ============================================================
